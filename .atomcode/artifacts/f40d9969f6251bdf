   877	        return 0
   878	
   879	    if args.loop_command == 'status':
   880	        if args.session:
   881	            matches = [p for p in sessions
   882	                       if os.path.basename(p).startswith(args.session)]
   883	            if not matches:
   884	                _out({'status': 'failed', 'error': {
   885	                    'code': 'action_not_found',
   886	                    'message': f'会话不存在: {args.session}'}})
   887	                return 1
   888	            path = matches[-1]
   889	        else:
   890	            if not sessions:
   891	                _out({'status': 'failed', 'error': {
   892	                    'code': 'action_not_found', 'message': '尚无 loop_prompt 会话'}})
   893	                return 1
   894	            path = sessions[-1]
   895	        try:
   896	            with open(path, 'r', encoding='utf-8') as f:
   897	                s = json.load(f)
   898	        except (OSError, ValueError) as e:
   899	            _out({'status': 'failed', 'error': {'code': 'internal',
   900	                                                'message': str(e)}})
   901	            return 1
   902	        ticks_path = path[:-len('.json')] + '.ticks.jsonl'
   903	        recent = []
   904	        if os.path.exists(ticks_path):
   905	            with open(ticks_path, 'r', encoding='utf-8') as f:
   906	                for line in f.readlines()[-5:]:
   907	                    try:
   908	                        recent.append(json.loads(line))
   909	                    except ValueError:
   910	                        pass
   911	        _out({'status': 'ok', 'data': {'session': s, 'recent_ticks': recent}})
   912	        return 0
   913	
   914	    if args.loop_command == 'stop':
   915	        target = args.session
   916	        proj_dir = None
   917	        for p in sessions:
   918	            if os.path.basename(p).startswith(target):
   919	                try:
   920	                    with open(p, 'r', encoding='utf-8') as f:
   921	                        s = json.load(f)
   922	                except (OSError, ValueError):
