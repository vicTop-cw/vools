   567	def _dispatch(args) -> int:
   568	    import vools.actus as actuscore
   569	    # vools.actus 包没有把 indexer.build_index 转出来（Actus 侧 actuscore/__init__.py 有），
   570	    # 直取子模块，否则 scan / validate 两条命令一调用就 AttributeError。
   571	    from vools.actus.indexer import build_index
   572	
   573	    if args.command == 'scan':
   574	        idx = build_index()
   575	        n = sum(1 for a in idx['actions'].values() if a.get('status') == 'valid')
   576	        _out({'status': 'ok', 'data': {
   577	            'total': len(idx['actions']), 'valid': n,
   578	            'index': '_meta/actions.index.json'}})
   579	        return 0
   580	
   581	    if args.command == 'list':
   582	        idx = actuscore.load_index()
   583	        # 分类体系 v2.0（docs/03 §2）：kind/purpose/industry/tag 过滤
   584	        kind_f = (getattr(args, 'kind', None) or '').strip().lower() or None
   585	        purpose_f = (getattr(args, 'purpose', None) or '').strip().lower() or None
   586	        industry_f = (getattr(args, 'industry', None) or '').strip().lower() or None
   587	        tag_f = (getattr(args, 'tag', None) or '').strip().lower() or None
   588	        tags = tag_f.split(',') if tag_f else None
   589	        rows = []
   590	        for aid, a in idx['actions'].items():
   591	            if aid.startswith('_invalid:') and not args.all:
   592	                continue
   593	            if a.get('status') != 'valid' and not args.all:
   594	                continue
   595	            if kind_f and (a.get('kind') or 'exec') != kind_f:
   596	                continue
   597	            if purpose_f and purpose_f not in (a.get('purpose') or ['utility']):
   598	                continue
   599	            if industry_f and industry_f not in (a.get('industry') or ['general']):
   600	                continue
   601	            if tags and not any(t in (a.get('tags') or []) for t in tags):
   602	                continue
   603	            rows.append({k: a.get(k) for k in
   604	                         ('id', 'name', 'version', 'trust', 'status', 'description',
   605	                          'kind', 'purpose', 'industry', 'tags')})
   606	        _out({'status': 'ok', 'data': {'actions': rows, 'count': len(rows)}})
   607	        return 0
   608	
   609	    if args.command == 'validate':
   610	        if not args.action_id:
   611	            idx = build_index()
   612	            bad = {aid: a.get('errors') for aid, a in idx['actions'].items()
   613	                   if a.get('status') != 'valid'}
   614	            _out({'status': 'ok', 'data': {'valid': not bad, 'invalid': bad}})
   615	            return 0 if not bad else 1
   616	        action = actuscore.get_action(args.action_id)
   617	        errs = actuscore.validate_action(action)
   618	        _out({'status': 'ok' if not errs else 'failed',
   619	              'data': {'id': args.action_id, 'errors': errs}})
   620	        return 0 if not errs else 1
   621	
   622	    if args.command == 'info':
   623	        action = actuscore.get_action(args.action_id)
   624	        _out({'status': 'ok', 'data': action.brief()})
   625	        return 0
   626	
   627	    if args.command == 'preview':
   628	        # 文件高亮模式
   629	        if args.file:
   630	            from vools.actus.highlight import highlight_file
   631	            mode = "html" if args.html else "terminal"
   632	            result = highlight_file(args.file, theme=args.theme, mode=mode)
   633	            print(result)
   634	            return 0
   635	
   636	        # 动作预览 + 代码高亮
   637	        p = actuscore.preview(args.action_id, _parse_params(args.params))
   638	        if args.html:
   639	            from vools.actus.highlight import highlight_code
   640	            # 对预览结果中的代码块进行高亮
   641	            if 'code_blocks' in p.get('data', {}):
   642	                for block in p['data']['code_blocks']:
   643	                    block['highlighted'] = highlight_code(
   644	                        block.get('code', ''),
   645	                        block.get('language', args.lang),
   646	                        theme=args.theme,
   647	                        mode='html'
   648	                    )
   649	        _out({'status': 'ok', 'data': p})
   650	        return 0
   651	
   652	    if args.command == 'run':
