     2	
     3	用法：
     4	    python -m actus scan                       # 扫描并重建索引
     5	    python -m actus list [--all]               # 列出动作（默认仅 valid）
     6	    python -m actus validate [id]              # 校验动作/全仓库
     7	    python -m actus info <id>                  # 查看动作元数据与依赖
     8	    python -m actus preview <id> [json参数]     # 干跑：展示将执行的块
     9	    python -m actus run <id> [json参数] [--confirm] [--yes]
    10	    python -m actus status [exec_id]           # 查询执行状态
    11	    python -m actus probe [--force-refresh] [--json] [--max-age N] [--verbose]  # 环境探测（ProbeReport）
    12	    python -m actus mcp [--transport stdio|sse] [--port 8765]  # 启动聚合 MCP server
    13	    python -m actus config <client>            # 生成 MCP 接入配置（claude/cursor/cline/vscode）
    14	    python -m actus scaffold <description>     # AI：根据描述生成动作骨架
    15	    python -m actus author <id> <instruction>  # AI：修改已有动作
    16	    python -m actus vault set <key> <value> [--scope] [--desc]  # 存储密钥
    17	    python -m actus vault get <key> [--scope]       # 获取密钥
    18	    python -m actus vault list [--scope]            # 列出密钥（不含值）
    19	    python -m actus vault delete <key> [--scope]    # 删除密钥
    20	    python -m actus runtimes                        # 列出可用多语言运行时
    21	    python -m actus execute --language <lang> --code <code>  # 执行代码片段
    22	    python -m actus records list [--action-id] [--limit] [--offset]  # 列出执行记录
    23	    python -m actus records export [--action-id] [--format json|csv|summary] [--output]  # 导出记录
    24	    python -m actus artifacts list [--action-id] [--exec-id] [--type]  # 列出产物
    25	    python -m actus artifacts cleanup [--max-age-days] [--max-count]  # 清理产物
    26	    python -m actus triggers add <action_id> <type> [--expr] [--path] [--key]  # 注册触发器
