   870	                'project_dir': s.get('project_dir'),
   871	                'started_at': s.get('started_at'),
   872	                'finished_at': s.get('finished_at'),
   873	                'exit_reason': s.get('exit_reason'),
   874	                'rounds_delivered': len(s.get('rounds') or []),
   875	            })
