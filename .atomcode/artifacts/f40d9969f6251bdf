    42	def main(argv=None) -> int:
    43	    """CLI 入口。"""
    44	    parser = _build_parser()
    45	    args = parser.parse_args(argv)
    46	
    47	    if args.command == 'mcp':
    48	        if args.transport == 'sse':
    49	            from .mcp_sse import serve_sse
    50	            serve_sse(port=args.port)
    51	        else:
    52	            from .mcp_server import serve
    53	            serve()
    54	        return 0
    55	
    56	    try:
    57	        return _dispatch(args)
    58	    except Exception as e:
    59	        _out({'status': 'failed', 'error': {
    60	            'code': getattr(e, 'code', 'internal'), 'message': str(e)}})
    61	        return 1
