   656	        _out(r)
   657	        if r['status'] == 'awaiting_confirmation':
   658	            print(f"待人类确认：再次执行并加 --confirm / --yes 放行（exec: {r['exec_id']}）",
   659	                  file=sys.stderr)
   660	        return 0 if r['status'] == 'ok' else 1
