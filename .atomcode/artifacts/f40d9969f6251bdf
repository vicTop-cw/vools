   928	                    return 1
   929	                proj_dir = s.get('project_dir')
   930	                break
   931	        if proj_dir is None and os.path.isdir(target):
   932	            proj_dir = target  # 也接受直接给项目路径
   933	        if proj_dir is None:
   934	            _out({'status': 'failed', 'error': {
