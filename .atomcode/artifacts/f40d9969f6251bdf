   940	            f.write('')
   941	        _out({'status': 'ok', 'data': {
   942	            'stop_file': stop_path.replace(os.sep, '/'),
   943	            'hint': '循环将在下一个 tick 内退出并清理 stop 文件'}})
   944	        return 0
   945	
   946	    _out({'status': 'failed', 'error': {
   947	        'code': 'param_invalid', 'message': '用法: actus loop stop|status|list'}})
   948	    return 1
