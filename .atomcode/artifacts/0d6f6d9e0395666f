   734	def _run_md_with_timeout(action: 'Action', build_dir: str, force: bool) -> dict:
   735	    """run_md 包装：按 action.resources.timeout_ms 施加超时（docs/46 #7）。
   736	
   737	    未配置 timeout_ms（0）时直接调 run_md，零开销零行为变化。
   738	    配置了则在独立线程执行，超时返回 `{'status': 'timeout', 'blocks': [...]}` 形状
   739	    的伪 report，让调用方按现有 timeout 分支（_run_blocks L801/L815）统一收口。
   740	    """
   741	    from vools.bridge.md import run_md
   742	
   743	    timeout_ms = action.timeout_ms
   744	    if not timeout_ms or timeout_ms <= 0:
   745	        return run_md(
   746	            action.path,
   747	            only=[action.entry] if action.entry else None,
   748	            force=force or True,
   749	            build_dir=build_dir,
   750	        )
   751	
   752	    # 超时执行：run_md 本身不接收 timeout 参数，用线程池强制收口。
   753	    from concurrent.futures import ThreadPoolExecutor, TimeoutError as FutureTimeout
   754	    with ThreadPoolExecutor(max_workers=1) as pool:
   755	        fut = pool.submit(run_md, action.path,
   756	                          only=[action.entry] if action.entry else None,
   757	                          force=force or True, build_dir=build_dir)
   758	        try:
   759	            return fut.result(timeout=timeout_ms / 1000.0)
   760	        except FutureTimeout:
   761	            # 无法强杀子进程（Windows 无 POSIX 信号），只标记 timeout 让上层收口
   762	            return {
   763	                'status': 'timeout',
   764	                'blocks': [{
   765	                    'index': 0, 'language': 'python', 'tag': [action.entry],
   766	                    'status': 'timeout', 'duration_ms': timeout_ms,
   767	                    'exit_code': None,
   768	                    'stdout': '', 'stderr': f'execution exceeded {timeout_ms}ms (docs/46 #7 resources.timeout_ms)',
   769	                }],
   770	            }
