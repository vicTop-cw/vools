    66	def _meta_dirs(meta_dir=None, artifacts_dir=None):
    67	    """解析 _meta 与 artifacts 目录。
    68	
    69	    传入 meta_dir 而未传 artifacts_dir 时，artifacts 取 meta_dir 的同级
    70	    artifacts（临时仓库隔离的关键：测试写 tmp_path 不落真实仓库）。
    71	    """
    72	    from .indexer import _repo_root
    73	    root = _repo_root()
    74	    meta = meta_dir or os.path.join(root, '_meta')
    75	    if artifacts_dir is None:
    76	        if meta_dir is not None:
    77	            artifacts = os.path.join(os.path.dirname(os.path.abspath(meta_dir)), 'artifacts')
    78	        else:
    79	            artifacts = os.path.join(root, 'artifacts')
    80	    else:
    81	        artifacts = artifacts_dir
    82	    return meta, artifacts
