   547	def _idempotent_replay(meta_dir: str, action: Action, params: dict):
   548	    """同幂等键且未过 TTL → 返回上次成功结果；否则 None。"""
   549	    from datetime import datetime as _dt
   550	    kv = _idempotent_key(action, params)
   551	    if kv is None:
   552	        return None
   553	    store = _idempotency_load(meta_dir)
   554	    entry = store.get(f'{kv[0]}::{kv[1]}')
   555	    if not entry:
   556	        return None
   557	    try:
   558	        created = _dt.fromisoformat(entry['at'])
   559	        age = (datetime.now(_TZ) - created).total_seconds()
   560	    except (KeyError, ValueError):
   561	        return None
   562	    if age > _IDEMPOTENT_TTL_SECONDS:
   563	        return None
   564	    record = records.load_run_record(meta_dir, entry['exec_id'])
   565	    if record is None or record.get('result', {}).get('status') != 'ok':
   566	        return None
   567	    return record['result']
