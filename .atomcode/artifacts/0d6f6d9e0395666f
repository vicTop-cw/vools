   590	def _visibility_gate(action: Action, action_id: str, exec_id: str,
   591	                     gated_key: str = None, gated_store=None) -> None:
   592	    """执行前的可见性门禁（docs/41 §B1）。
   593	
   594	    **只判新增的 internal / gated 两级，既有四级（public/unlisted/private/team）
   595	    一律原样放行。** 这不是偷懒，是兼容性判据：实测这四级在现行执行链上从来没有
   596	    被门禁过（executor 早前根本不 import visibility），若在这里给它们补上判据，
   597	    `visibility: private` 的既有动机会当场开始报 `Private action not found`
   598	    （私有索引里根本没有它们的记录），属于凭空造回归。新级别的收紧与旧级别的行为
   599	    不变是两件事，分开做才看得见。
   600	
   601	    internal 的放行判据是**物理落位**（`actions/system/_internal/`，docs/41 §B1）：
   602	    落在该目录下才算引擎内部路由；把任意动作标成 `visibility: internal` 想借此
   603	    绕过市场/签名链路的，这里当场拒掉 —— 落位是权威，声明只是意图。
   604	
   605	    gated 的放行判据是密钥：显式参数 → `ACTUS_GATED_KEY` 环境变量 → vault，
   606	    三者都取不到或校验不过 → `auth_required`（docs/41 §B2.3）。密钥明文只在这里
   607	    过一遍，不进 record、不进日志。
   608	    """
   609	    visibility = (action.meta.get('visibility') or '').strip().lower()
   610	
   611	    if visibility == 'internal':
   612	        from .visibility import is_internal_path
   613	        if not is_internal_path(action.path):
   614	            record_gate(action_id, visibility, exec_id, granted=False)
   615	            raise ActionError(
   616	                'visibility_denied',
   617	                f"internal 动作 '{action_id}' 未落在 _internal/ 目录，"
   618	                f"拒绝按内部路由执行（当前路径：{action.path}）",
   619	                {'visibility': visibility, 'path': action.path})
   620	        record_gate(action_id, visibility, exec_id, granted=True)
   621	        return
   622	
   623	    if visibility == 'gated':
   624	        from .visibility import AUTH_REQUIRED, GatedKeyStore
   625	        key = gated_key or os.environ.get('ACTUS_GATED_KEY', '')
   626	        if not key:
   627	            try:
   628	                from .vault import get_key
   629	                key = get_key('gated_key',
   630	                              meta_dir=os.environ.get('ACTUS_META_DIR', '')) or ''
   631	            except Exception:       # noqa: BLE001 —— vault 不可用等同"没有密钥"
   632	                key = ''
   633	        if not key:
   634	            record_gate(action_id, visibility, exec_id, granted=False)
   635	            raise ActionError(
   636	                'auth_required',
   637	                f"动作 '{action_id}' 为 gated 可见性，执行需授权密钥"
   638	                f"（--key / ACTUS_GATED_KEY / vault gated_key 三者之一）",
   639	                {'visibility': visibility})
   640	        repo = action.meta.get('repo') or ''
   641	        # 仓储可注入：默认落 ~/.actus/gated_keys.json（与 VisibilityEngine 同根）。
   642	        # 取不到仓储（文件损坏等）一律按"未授权"拒 —— fail-closed，不静默放行。
   643	        try:
   644	            store = gated_store if gated_store is not None else GatedKeyStore()
   645	        except RuntimeError as exc:
   646	            record_gate(action_id, visibility, exec_id, granted=False)
   647	            raise ActionError('auth_required', str(exc), {'visibility': visibility})
   648	        if not store.verify(key, action_id=action_id, repo=repo):
   649	            record_gate(action_id, visibility, exec_id, granted=False)
   650	            raise ActionError(
   651	                'auth_required',
   652	                f"动作 '{action_id}' 的授权密钥无效或已被轮换撤销",
   653	                {'visibility': visibility, 'reason': AUTH_REQUIRED})
   654	        record_gate(action_id, visibility, exec_id, granted=True)
   655	        return
   656	
   657	    # 既有四级（public/unlisted/private/team）在现行执行链上没有任何门禁，这里也
   658	    # **不做判定也不写审计** —— 若在此写一条 granted=True，审计记录会谎称"做过
   659	    # 可见性校验并通过"，而事实是一个字节都没查。只记录真实发生的判定。
