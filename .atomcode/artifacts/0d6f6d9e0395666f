   133	def execute(action_id: str, params: dict = None,
   134	            confirmed: bool = False, meta_dir: str = None,
   135	            actions_dir: str = None, force: bool = False,
   136	            artifacts_dir: str = None, preparsed_action: 'Action' = None) -> dict:
   137	    """执行一个动作，返回 docs/03 §7.2 结构化出参。
   138	
   139	    confirmed=True 表示人类已通过确认通道放行（audit 级需要）。
   140	    meta_dir/artifacts_dir 可覆盖留痕与产物落点（临时仓库隔离）。
   141	    preparsed_action：已解析好的 Action（零散动作专用，docs/41 §5 主题 C）。
   142	      零散动作在**任意路径**，且缺省字段（trust=audit / visibility=private，
   143	      docs/41 §C1）是在解析后补上的；execute 若再从磁盘 re-parse，补上的缺省值
   144	      当场丢失 → 校验报 trust 缺失。传进来即用同一份对象，缺省值不再被抹掉。
   145	      仍然走完整的 validating/trust/sandbox/Ω 门禁 —— 只是"对象从哪来"变了。
   146	      **名字不能叫 action_obj**：下面依赖预检那段有同名本地变量 `action_obj = None`，
   147	      参数会被当场覆盖（实测踩到过）。
   148	    全程留痕：_meta/runs/<exec_id>.json + status.json + 追加式日志。
   149	    """
   150	    params = params if params is not None else {}
   151	
   152	    # 入参深度闸门（BUG-0017）：位置必须在建 record 之前 —— record['params']、
   153	    # _validate_params 与 _run_blocks 里的 json.dumps(params) 都会把这份入参整个递归
   154	    # 走一遍，5000 层嵌套能让 RecursionError 从 PROCESS_STATE_LOCK 临界区里穿出出入口，
   155	    # 而引擎对外承诺的是 docs/03 §7.2 的结构化回执（CLI/MCP 拿到 traceback 就没法分流）。
   156	    depth = _payload_depth(params)
   157	    if depth > _MAX_PARAM_DEPTH:
   158	        return {
   159	            'status': 'failed',
   160	            'data': None,
   161	            'error': {
   162	                'code': 'param_invalid',
   163	                'message': f'入参嵌套过深（深度 {depth} > 上限 {_MAX_PARAM_DEPTH}），已按契约拒绝',
   164	                'details': {'depth': depth, 'max_depth': _MAX_PARAM_DEPTH},
   165	            },
   166	        }
   167	
   168	    meta_dir, artifacts_dir = _meta_dirs(meta_dir, artifacts_dir)
   169	    exec_id = new_exec_id()
   170	    _t_start = time.time()  # 使用量指标计时起点（docs/03 §4.1）
   171	
   172	    # ── 依赖检查（执行前）──
   173	    action_obj = None
   174	    dep_check = None
   175	    try:
   176	        from .indexer import get_action
   177	        action_obj = load_and_validate(get_action(action_id, actions_dir).path)
   178	        if action_obj.dependencies:
   179	            resolver = DependencyResolver(actions_root=actions_dir)
   180	            dep_states = []
   181	            lazy_hints = []
   182	            hard_missing = []
   183	            for dep in action_obj.dependencies:
   184	                chk = resolver.check_dep(dep)
   185	                dep_type = getattr(getattr(dep, 'type', ''), 'value', getattr(dep, 'type', ''))
   186	                strategy = getattr(getattr(dep, 'strategy', None), 'value', None)
   187	                ephemeral_cmd = getattr(chk, 'ephemeral_cmd', '')
   188	                dep_states.append({
   189	                    'name': dep.name,
   190	                    'type': dep_type,
   191	                    'strategy': strategy,
   192	                    'required': dep.required,
   193	                    'satisfied': chk.satisfied,
   194	                    'message': chk.message,
   195	                    'fix_command': chk.fix_command,
   196	                    'ephemeral_cmd': ephemeral_cmd,
   197	                })
   198	                if chk.satisfied:
   199	                    continue
   200	                # D3 懒加载：hint/ephemeral/download 策略不硬失败，仅附提示
   201	                actionable = bool(
   202	                    chk.fix_command or ephemeral_cmd
   203	                    or getattr(chk, 'download_url', '')
   204	                )
   205	                if strategy is not None:
   206	                    lazy = strategy != 'fail'
   207	                else:
   208	                    lazy = actionable or dep_type in (
   209	                        'system', 'python', 'npm', 'lang', 'mcp')
   210	                if lazy:
   211	                    lazy_hints.append({
   212	                        'name': chk.name,
   213	                        'type': dep_type,
   214	                        'strategy': strategy,
   215	                        'message': chk.message,
   216	                        'fix_command': chk.fix_command,
   217	                        'ephemeral_cmd': ephemeral_cmd,
   218	                    })
   219	                elif dep.required:
   220	                    hard_missing.append({'name': chk.name, 'message': chk.message})
   221	            dep_check = {
   222	                'satisfied': not hard_missing,
   223	                'deps': dep_states,
   224	                'lazy': lazy_hints,
   225	                'missing': hard_missing,
   226	            }
   227	            if hard_missing and not force:
   228	                result = {
   229	                    "status": "failed",
   230	                    "error": {
   231	                        "code": "deps_missing",
   232	                        "message": "必需依赖缺失，可使用 force=True 强制执行",
   233	                        "details": {"missing": hard_missing},
   234	                    },
   235	                    "deps": dep_check
   236	                }
   237	                return result
   238	    except Exception:
   239	        # 依赖预检为尽力而为：解析失败不在此处定论，交由主流程 validating 阶段给结构化错误
   240	        action_obj = None
   241	        dep_check = None
   242	        pass
   243	
   244	    record = {
   245	        'exec_id': exec_id,
   246	        'action': action_id,
   247	        'params': params,
   248	        'confirmed': bool(confirmed),
   249	        'state_transitions': [],
   250	        'blocks': [],
   251	        'artifacts': [],
   252	        'sandboxed': False,
   253	    }
   254	
   255	    def transit(state: str):
   256	        record['state_transitions'].append(
   257	            {'state': state, 'at': datetime.now(_TZ).isoformat(timespec='seconds')})
   258	
   259	    def finish(result: dict) -> dict:
   260	        # 先补全 exec_id 再落盘，保证记录里的 result 自含标识
   261	        result['exec_id'] = exec_id
   262	        # docs/46 #5/#6/#7：回执带 mode / env_prefix / resources 摘要
   263	        # （action 在异常路径可能未解析成功，用局部判断兜住）
   264	        try:
   265	            result['mode'] = action.exec_mode
   266	            result['env_prefix'] = action.env_prefix
   267	            if record.get('resources'):
   268	                result['resources'] = record['resources']
   269	        except (NameError, AttributeError):
   270	            result['mode'] = 'sync'
   271	            result['env_prefix'] = 'ACTUS_'
   272	        # D3：懒加载策略缺失的依赖不阻断执行，以提示形式随结果返回
   273	        if dep_check and dep_check.get('lazy'):
   274	            result['deps_hints'] = dep_check['lazy']
   275	        record['result'] = result
   276	        # ── 释放并发槽位 ──
   277	        if record.get('concurrency', {}).get('max', 0) > 0:
   278	            mgr_release = get_manager()
   279	            mgr_release.release_slot(action_id, exec_id)
   280	            result['concurrency'] = {
   281	                'max': record['concurrency']['max'],
   282	                'released': True,
   283	                'remaining': mgr_release.get_running_count(action_id)
   284	            }
   285	        # ── Ω-gate 验证（金条八：任何产出必须过 Ω-gate）──
   286	        spec_path = _find_omega_spec(action_id, actions_dir)
   287	        if spec_path and result.get('status') in ('ok', 'partial'):
   288	            try:
   289	                omega_report = verify_output(spec_path, result)
   290	                result['omega'] = omega_report
   291	                if omega_report.get('status') == 'spec_error':
   292	                    # 「无法评估」不是「过了门禁」（BUG-0015）。spec 不合格时 verify_output
   293	                    # 回的是 {'status':'spec_error','errors':[...]}，**没有 gate 键**，
   294	                    # 原先 `get('gate', {}).get('passed', True)` 的缺省 True 正好把它读成通过
   295	                    # —— 契约坏掉时金条八静默放行，比判错更糟因为它不留痕。
   296	                    errs = omega_report.get('errors') or []
   297	                    result['status'] = 'failed'
   298	                    result['error'] = {
   299	                        'code': 'omega_spec_invalid',
   300	                        'message': f"Ω 契约不可评估（spec 不合格）：{'; '.join(str(e) for e in errs[:3])}",
   301	                        'details': omega_report,
   302	                    }
   303	                elif not omega_report.get('gate', {}).get('passed', False):
   304	                    # 缺省值取 False：走到这里 gate 必然存在（pass/fail 两条都带），
   305	                    # 但万一将来新增第三种回包形状，宁可判不过也不放行。
   306	                    result['status'] = 'failed'
   307	                    result['error'] = {
   308	                        'code': 'omega_gate_failed',
   309	                        'message': f"Ω-gate 验证失败，准确率 {omega_report['gate'].get('accuracy', 0)}% < 100%",
   310	                        'details': omega_report
   311	                    }
   312	            except Exception as e:
   313	                # 原本 `except Exception: pass` 把坏 spec 抹平成「这个动作没配 spec」——
   314	                # 两种情况的回执完全同形，调用方无从分辨。现在既留痕也判不过。
   315	                result['omega'] = {
   316	                    'status': 'spec_error',
   317	                    'errors': [f'{type(e).__name__}: {e}'],
   318	                    'spec_path': spec_path.replace(os.sep, '/'),
   319	                }
   320	                result['status'] = 'failed'
   321	                result['error'] = {
   322	                    'code': 'omega_spec_invalid',
   323	                    'message': f'Ω spec 加载失败：{type(e).__name__}: {e}',
   324	                    'details': result['omega'],
   325	                }
   326	        record_path = records.write_run_record(meta_dir, record)
   327	        result['record'] = record_path.replace(os.sep, '/')
   328	        records.update_status(meta_dir, exec_id, action_id,
   329	                              result['status'],
   330	                              (result.get('error') or {}).get('message'))
   331	        records.append_log(meta_dir, f"{exec_id} {action_id} -> {result['status']}")
   332	
   333	        # ── 使用量指标埋点（docs/03 §4.1：执行计数区分「安装了」vs「真正在用」）──
   334	        # best-effort：写指标失败绝不影响执行结果（与 calllog 设计一致）。
   335	        # 落点与 call_log 同库（_meta/call_log.db 的 action_metrics 表），
   336	        # popular_actions / trending_actions / quality_scale 全部消费此数据。
   337	        # caller 记调用来源：confirmed=True 的人工放行 vs False 的 MCP/CLI 自动调用，
   338	        # 让 unique_callers 聚合能区分"哪个通道在用"（docs/03 §4.1）。
   339	        try:
   340	            from .calllog import write_action_metric
   341	            write_action_metric(
   342	                action_id,
   343	                ok=(result['status'] in ('ok', 'partial')),
   344	                runtime_ms=int((time.time() - _t_start) * 1000),
   345	                caller='confirmed' if confirmed else 'executor',
   346	                meta_dir=meta_dir,
   347	            )
   348	        except Exception:
   349	            pass  # best-effort：指标缺失不改变回执
   350	
   351	        # ── 事件总线通知 (Phase G5) ──
   352	        try:
   353	            from .eventbus import EventType, get_event_bus
   354	            bus = get_event_bus()
   355	            if result['status'] == 'ok':
   356	                bus.publish(EventType.ACTION_COMPLETED, {
   357	                    'action_id': action_id,
   358	                    'exec_id': exec_id,
   359	                    'params': params,
   360	                    'result': result.get('data'),
   361	                }, source='executor')
   362	            elif result['status'] == 'failed':
   363	                bus.publish(EventType.ACTION_FAILED, {
   364	                    'action_id': action_id,
   365	                    'exec_id': exec_id,
   366	                    'params': params,
   367	                    'error': result.get('error'),
   368	                }, source='executor')
   369	        except Exception:
   370	            pass  # 事件总线异常不阻塞执行
   371	
   372	        return result
   373	
   374	    try:
   375	        # ── pending ──
   376	        transit('pending')
   377	
   378	        # ── validating ──
   379	        transit('validating')
   380	        if preparsed_action is not None:
   381	            action = preparsed_action
   382	        else:
   383	            action = load_and_validate(
   384	                _resolve_path(action_id, actions_dir)) if actions_dir else None
   385	            if action is None:
   386	                action = _get_validated(action_id)
   387	
   388	        # docs/46 #5/#6/#7：mode / context / resources 契约消费
   389	        record['mode'] = action.exec_mode
   390	        record['env_prefix'] = action.env_prefix
   391	        record['resources'] = {
   392	            'timeout_ms': action.timeout_ms,
   393	            'max_memory_mb': action.max_memory_mb,
   394	            'max_processes': action.max_processes,
   395	            'net_connect': action.net_connect,
   396	            'net_listen': action.net_listen,
   397	        } if (action.timeout_ms or action.max_memory_mb or action.max_processes
   398	              or action.net_connect or action.net_listen) else {}
   399	
   400	        _validate_params(action, params)
   401	
   402	        # 依赖图校验（含本动作的 deps）
   403	        all_actions = scan_actions(actions_dir, validate=False)
   404	        sub = {aid: a for aid, a in all_actions.items()
   405	               if aid == action_id or aid in (action.meta.get('deps') or [])}
   406	        validate_graph(sub)
   407	
   408	        # ── 可见性门禁（docs/41 §B1）：只判新增的 internal / gated 两级 ──
   409	        _visibility_gate(action, action_id, exec_id)
   410	
   411	        # ── trust 判定 ──
   412	        # ACTUS_DEBUG 开发模式（true/1/yes/on）：audit 级动作自动放行，
   413	        # 免去每次人工确认（git.ops 等 audit 动作在开发仓联调时不再卡 awaiting）。
   414	        # 使用模式（false/缺省）：audit 仍须人工确认，行为不变。
   415	        _dev = os.environ.get('ACTUS_DEBUG', '').strip().lower() in ('1', 'true', 'yes', 'on')
   416	        if _dev and action.trust == 'audit':
   417	            confirmed = True
   418	            record['dev_auto_confirm'] = True
   419	        strategy = decide(action.trust, confirmed=confirmed)
   420	        record['trust'] = action.trust
   421	        record['strategy'] = strategy
   422	
   423	        if strategy == 'need_confirm':
   424	            # docs/07 §2：改动型动作等人类确认，展示完整待执行明细
   425	            transit('awaiting_confirmation')
