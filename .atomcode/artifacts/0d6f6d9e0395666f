    99	def _inject_params_into_body(action: Action, params: dict) -> str:
   100	    """把入参以 __actus_params 注入执行环境。
   101	
   102	    vools 的 python 块经 exec 执行，这里在正文最前追加一段引导代码：
   103	    定义 __actus_params 变量与 __actus_result 输出通道，供动作代码读写。
   104	    """
   105	    bootstrap = (
   106	        '\n\n```python #!run tag=__actus_bootstrap skip\n'
   107	        '# Actus 注入：参数与结果通道（本块不单独执行）\n'
   108	        '```\n'
   109	    )
   110	    # 注入通过环境变量传递更稳妥：ACTUS_PARAMS (JSON) —— vools _execute_python
   111	    # 的 exec_env 来自 config['env']，这里直接在 md 顶部加一个 python 配置块不可行，
   112	    # 故采用 wrapper：入口块执行前由 executor 将参数写入全局 config env。
   113	    return action.body + bootstrap
