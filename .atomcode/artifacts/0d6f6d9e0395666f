   698	def _sanitize_path_env() -> None:
   699	    """PATH 去重瘦身 + System32 前置（执行环境保障）。
   700	
   701	    背景：vools import 链会向 PATH 大量 prepend 编译器路径，把 PATH 撑过
   702	    cmd.exe 约 8191 字符的搜索缓冲，System32 被挤出搜索范围，动作里的
   703	    os.popen/subprocess 按相对名调用系统命令（如 wsl.exe）会报
   704	    "not recognized"。此处只做保序去重与前移，不删除任何已有目录。
   705	    """
   706	    path = os.environ.get('PATH', '')
   707	    if not path or len(path) <= 8000:
   708	        return
   709	    sys32 = os.path.join(os.environ.get('SystemRoot', r'C:\Windows'), 'System32')
   710	    seen, cleaned = set(), []
   711	    for it in path.split(';'):
   712	        k = it.strip().lower().rstrip('\\')
   713	        if k and k not in seen:
   714	            seen.add(k)
   715	            cleaned.append(it)
   716	    cleaned = [p for p in cleaned if p.strip().lower().rstrip('\\') != sys32.lower()]
   717	    cleaned.insert(0, sys32)
   718	    os.environ['PATH'] = ';'.join(cleaned)
