    85	def _validate_params(action: Action, params: dict) -> None:
    86	    """按 args JSON Schema 校验入参（docs/03 §7.1），非法抛 param_invalid。"""
    87	    schema = action.args_schema
    88	    if schema is None:
    89	        return
    90	    try:
    91	        import jsonschema
    92	        jsonschema.validate(instance=params, schema=schema)
    93	    except Exception as e:
    94	        msg = getattr(e, 'message', str(e))
    95	        raise ActionError('param_invalid', f'入参校验失败: {msg}',
    96	                          {'schema': schema}) from e
