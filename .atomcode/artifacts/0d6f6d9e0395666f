   116	def _payload_depth(obj) -> int:
   117	    """求嵌套深度。**刻意用迭代而不是递归**：量深参的尺子如果自己也递归，
   118	    它就是第一个被同一份入参炸掉的东西（BUG-0017 的现场正是 json.dumps 递归爆栈）。
   119	    """
   120	    maxd = 0
   121	    stack = [(obj, 1)]
   122	    while stack:
   123	        cur, d = stack.pop()
   124	        if d > maxd:
   125	            maxd = d
   126	        if isinstance(cur, dict):
   127	            stack.extend((v, d + 1) for v in cur.values())
   128	        elif isinstance(cur, (list, tuple)):
   129	            stack.extend((v, d + 1) for v in cur)
   130	    return maxd
