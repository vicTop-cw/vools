   957	def _register_artifacts(meta_dir: str, action: Action, exec_id: str,
   958	                        artifacts: list) -> None:
   959	    """产物登记 _meta/artifacts.json（docs/04 §3：名称/路径/哈希/来源动作/版本）。"""
   960	    if not artifacts:
   961	        return
   962	    path = os.path.join(meta_dir, 'artifacts.json')
   963	    reg = {'actions': {}}
   964	    if os.path.exists(path):
   965	        try:
   966	            with open(path, 'r', encoding='utf-8') as f:
   967	                reg = json.load(f)
   968	        except (json.JSONDecodeError, OSError):
   969	            reg = {'actions': {}}
   970	
   971	    import hashlib
   972	    actions_reg = reg.setdefault('actions', {})
   973	    ver_reg = actions_reg.setdefault(action.id, {}).setdefault(
   974	        action.meta.get('version', '0.0.0'), {'artifacts': {}})
   975	    table = ver_reg.setdefault('artifacts', {})
   976	    for a in artifacts:
   977	        p = a.get('path')
   978	        sha = a.get('hash')
   979	        if p and os.path.exists(p) and not sha:
   980	            with open(p, 'rb') as f:
   981	                sha = hashlib.sha256(f.read()).hexdigest()
   982	        table[a.get('name') or f'block_{a.get("block")}'] = {
   983	            'path': (p or '').replace(os.sep, '/'),
   984	            'sha256': sha,
   985	            'source_exec': exec_id,
   986	            'block': a.get('block'),
   987	        }
   988	    os.makedirs(meta_dir, exist_ok=True)
   989	    with open(path, 'w', encoding='utf-8') as f:
   990	        json.dump(reg, f, ensure_ascii=False, indent=2)
