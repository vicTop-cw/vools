// shutil.vox — Vox standard library: high-level file and directory operations
// Provides high-level file operations like copying, moving, and
// removing files and directories, modeled after Python's shutil module.

/// Copy the contents of src to dst (no metadata).
/// shutil.copyfile(src, dst) -> void
def copyfile(src: str, dst: str) -> void:
    let _ = std::fs::copy(src, dst)

/// Copy file and permissions (shutil.copy).
/// shutil.copy(src, dst) -> void
def copy(src: str, dst: str) -> void:
    let _ = std::fs::copy(src, dst)

/// Copy file with metadata (shutil.copy2).
/// shutil.copy2(src, dst) -> void
def copy2(src: str, dst: str) -> void:
    let _ = std::fs::copy(src, dst)

/// Copy data from fsrc to fdst in chunks.
/// shutil.copyfileobj(fsrc, fdst, length=16384) -> void
def copyfileobj(fsrc: int, fdst: int, length: int = 16384) -> void:
    let mut __buf = vec![0u8; length]
    loop:
        let __n = std::io::Read::read(&mut fsrc, &mut __buf).unwrap_or(0)
        if __n == 0:
            break
        std::io::Write::write_all(&mut fdst, &__buf[..__n]).unwrap_or(())

/// Recursively move a file or directory to another location.
/// shutil.move(src, dst) -> void
def move(src: str, dst: str) -> void:
    if std::fs::rename(&src, &dst).is_err():
        let _ = std::fs::copy(&src, &dst)
        let _ = std::fs::remove_file(&src)

/// Recursively delete a directory tree.
/// shutil.rmtree(path) -> void
def rmtree(path: str) -> void:
    let _ = std::fs::remove_dir_all(path)

/// Return disk usage statistics for the given path.
/// shutil.disk_usage(path) -> (total, used, free)
def disk_usage(path: str) -> tuple:
    let __meta = std::fs::metadata(&path).unwrap()
    return (0, 0, __meta.len())

/// Find the full path of an executable by searching PATH.
/// shutil.which(cmd) -> str
def which(cmd: str) -> str:
    let __path = std::env::var("PATH").unwrap_or_default()
    let __found = __path.split(';').map(|d| std::path::Path::new(d).join(&cmd)).find(|p| p.exists())
    return __found.map(|p| p.to_string_lossy().to_string()).unwrap_or_default()

/// Create an archive file (zip, tar).
/// shutil.make_archive(base_name, format, root_dir) -> str
def make_archive(base_name: str, format: str, root_dir: str) -> str:
    return ""

/// Unpack an archive file.
/// shutil.unpack_archive(filename, extract_dir) -> void
def unpack_archive(filename: str, extract_dir: str = ".") -> void:
    let _ = filename
    let _ = extract_dir

/// Return a list of supported archive formats.
/// shutil.get_archive_formats() -> list
def get_archive_formats() -> list:
    return [("zip", "ZIP"), ("tar", "TAR")]

/// Change the owner of a path (simplified, no-op on most systems).
/// shutil.chown(path, user=None, group=None) -> void
def chown(path: str, user: int = 0, group: int = 0) -> void:
    let _ = path
