// tempfile.vox — Vox standard library: temporary file and directory creation
// Provides functions for creating temporary files and directories,
// modeled after Python's tempfile module.

/// Return the name of the directory used for temporary files.
/// tempfile.gettempdir() -> str
def gettempdir() -> str:
    return std::env::temp_dir().to_string_lossy().to_string()

/// Return the name of the directory used for temporary files as bytes.
/// tempfile.gettempdirb() -> bytes
def gettempdirb() -> list:
    return std::env::temp_dir().to_path_buf().into_os_string().into_string().unwrap_or_default().into_bytes()

/// Return the filename prefix used to create temporary files.
/// tempfile.gettempprefix() -> str
def gettempprefix() -> str:
    return "tmp"

/// Return a unique temporary filename (deprecated, use mkstemp).
/// tempfile.mktemp(suffix="", prefix="tmp", dir=None) -> str
def mktemp(suffix: str = "", prefix: str = "tmp", dir: str = "") -> str:
    let __dir = std::path::PathBuf::from(dir)
    let __name = format!("{}{}{}", prefix, std::process::id(), suffix)
    return __dir.join(__name).to_string_lossy().to_string()

/// Create a temporary file and return (fd, path).
/// tempfile.mkstemp(suffix="", prefix="tmp", dir=None) -> (int, str)
def mkstemp(suffix: str = "", prefix: str = "tmp", dir: str = "") -> tuple:
    let __dir = std::path::PathBuf::from(dir)
    let __name = format!("{}{}{}", prefix, std::process::id(), suffix)
    let __path = __dir.join(__name)
    let _ = std::fs::File::create(&__path)
    return (0, __path.to_string_lossy().to_string())

/// Create a temporary directory and return its path.
/// tempfile.mkdtemp(suffix="", prefix="tmp", dir=None) -> str
def mkdtemp(suffix: str = "", prefix: str = "tmp", dir: str = "") -> str:
    let __dir = std::path::PathBuf::from(dir)
    let __name = format!("{}{}{}", prefix, std::process::id(), suffix)
    let __path = __dir.join(__name)
    let _ = std::fs::create_dir(&__path)
    return __path.to_string_lossy().to_string()

/// Create and return a temporary file path.
/// tempfile.NamedTemporaryFile(suffix="", prefix="tmp") -> str
def NamedTemporaryFile(suffix: str = "", prefix: str = "tmp") -> str:
    let __dir = std::env::temp_dir()
    let __name = format!("{}_{}{}", prefix, std::process::id(), suffix)
    let __path = __dir.join(__name)
    let _ = std::fs::File::create(&__path)
    return __path.to_string_lossy().to_string()

/// Alias for NamedTemporaryFile.
/// tempfile.TemporaryFile(suffix="", prefix="tmp") -> str
def TemporaryFile(suffix: str = "", prefix: str = "tmp") -> str:
    return NamedTemporaryFile(suffix, prefix)

/// Create a spooled temporary file.
/// tempfile.SpooledTemporaryFile(max_size=0, suffix="", prefix="tmp") -> str
def SpooledTemporaryFile(max_size: int = 0, suffix: str = "", prefix: str = "tmp") -> str:
    return NamedTemporaryFile(suffix, prefix)
