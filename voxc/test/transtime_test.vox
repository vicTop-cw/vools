// Test transtime and comptime blocks

// transtime: executed at Vox transpilation time
// Can modify Cargo.toml, generate extra files, set config
transtime:
    toml.dependency("serde", "1.0")
    toml.feature("serde", ["derive"])
    config.set("edition", "2021")
    file.write("extra.rs", "// Extra file generated by transtime\npub fn extra_fn() -> i64 { 42 }\n")

// comptime: executed by rustc at compile time
// Generates actual Rust const evaluation code
comptime:
    const PI = 3.14159
    const MAX = 100

struct Point:
    x: int
    y: int

def add(a: int, b: int) -> int:
    return a + b

def main() -> void:
    // inspect tests
    print(inspect.signature(add))
    print(reflect.type_name(Point))
    print(reflect.is_struct(Point))
    
    // Regular runtime code
    var p = Point(1, 2)
    print(p.x)
    print(add(3, 4))
