// string_re_funcs_test.vox — Tests for string, re, and funcs standard library modules

def main() -> void:
    // ===== string module tests =====

    // Constants
    print(string.digits)
    print(string.ascii_lowercase)
    print(string.ascii_uppercase)
    print(string.ascii_letters)
    print(string.hexdigits)
    print(string.octdigits)
    print(string.punctuation)
    print(string.whitespace)

    // split
    val parts = string.split("a,b,c,d", ",")
    print(parts)

    // find
    val idx = string.find("hello world", "world")
    print(idx)

    // replace
    val r = string.replace("hello world", "world", "vox")
    print(r)

    // strip / lstrip / rstrip
    print(string.strip("  hello  "))
    print(string.lstrip("  hello  "))
    print(string.rstrip("  hello  "))

    // upper / lower / title
    print(string.upper("hello"))
    print(string.lower("HELLO"))
    print(string.title("hello world"))

    // startswith / endswith / contains
    print(string.startswith("hello world", "hello"))
    print(string.endswith("hello world", "world"))
    print(string.contains("hello world", "lo wo"))

    // center / ljust / rjust / zfill
    print(string.center("hi", 10))
    print(string.ljust("hi", 10))
    print(string.rjust("hi", 10))
    print(string.zfill("42", 5))

    // capwords
    print(string.capwords("hello world foo bar"))

    // ===== re module tests =====

    // match / search
    print(re.match(r"\d+", "123abc"))
    print(re.search(r"\d+", "abc123"))

    // findall
    val matches = re.findall(r"\d+", "a1b2c3")
    print(matches)

    // sub
    val result = re.sub(r"\d+", "N", "a1b2c3")
    print(result)

    // split
    val re_parts = re.split(r",", "a,b,c")
    print(re_parts)

    // escape
    print(re.escape("hello.world*test"))

    // ===== funcs module tests =====

    // identity
    print(funcs.identity(42))

    // compose: use lambdas |x| x + 1
    val add_then_double = funcs.compose(|x| x * 2, |x| x + 1)
    print(add_then_double(5))

    // partial
    val add_five = funcs.partial(|a, b| a + b, 5)
    print(add_five(10))

    // reduce
    print(funcs.reduce(|a, b| a + b, [1, 2, 3, 4, 5]))
    print(funcs.reduce(|a, b| a + b, [1, 2, 3, 4, 5], 100))

    // constantly
    val always_zero = funcs.constantly(0)
    print(always_zero(999))

    print("All tests completed")
