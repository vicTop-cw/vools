{
  "def": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:params}) -> ${3:ReturnType}:",
      "    ${0:body}"
    ],
    "description": "Function definition"
  },
  "fn": {
    "prefix": "fn",
    "body": [
      "def ${1:name}(${2:params}):",
      "    ${0:body}"
    ],
    "description": "Function without return type"
  },
  "val": {
    "prefix": "val",
    "body": [
      "val ${1:name} = ${2:value}"
    ],
    "description": "Immutable variable"
  },
  "var": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value}"
    ],
    "description": "Mutable variable"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    ${0:body}"
    ],
    "description": "If statement"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}:",
      "    ${2:body}",
      "else:",
      "    ${0:else_body}"
    ],
    "description": "If-else statement"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:expr}:",
      "    ${2:pattern} => ${3:body}",
      "    _ => ${0:default}"
    ],
    "description": "Match expression"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iterable}:",
      "    ${0:body}"
    ],
    "description": "For loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "    ${0:body}"
    ],
    "description": "While loop"
  },
  "loop": {
    "prefix": "loop",
    "body": [
      "loop:",
      "    ${0:body}"
    ],
    "description": "Infinite loop"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "    ${0:body}"
    ],
    "description": "Class definition"
  },
  "template": {
    "prefix": "template",
    "body": [
      "template ${1:name}<${2:T}>(${3:params}):",
      "    ${0:body}"
    ],
    "description": "Template declaration"
  },
  "define": {
    "prefix": "define",
    "body": [
      "define: ${1:Name}<${2:T}>: {",
      "    ${3:constraints}",
      "}"
    ],
    "description": "Type constraint definition"
  },
  "trycatch": {
    "prefix": "trycatch",
    "body": [
      "try:",
      "    ${1:body}",
      "catch ${2:e}:",
      "    ${0:handler}"
    ],
    "description": "Try-catch block"
  }
}